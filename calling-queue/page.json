          },
          {
            "key": "actions",
            "align": "right",
            "title": "Actions",
            "sticky": "right",
            "actions": [
              {
                "id": "assignToMe",
                "icon": "user-check",
                "label": "Assign to Me",
                "method": "POST",
                "variant": "success",
                "endpoint": "/pulse-service/api/v1/tickets/{id}/claim",
                "onFailure": {
                  "target": "/tickets/rizz-calling/{id}",
                  "actionType": "navigate"
                },
                "onSuccess": {
                  "target": "/tickets/rizz-calling/{id}",
                  "actionType": "navigate"
                },
                "actionType": "apiCall",
                "errorMessage": "Failed to claim ticket.",
                "successMessage": "Ticket claimed successfully!",
                "validationSchema": {
                  "type": "object",
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
