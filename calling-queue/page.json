  "footer": null,
  "header": null,
  "pageId": "rizz-calling-queue",
  "dataSource": {
    "stats": {
      "params": {
        "categoryId": "{categoryId}"
      },
      "provider": "categoryQueueStats"
    },
    "shiftStatus": {
      "params": {
        "categoryId": "{categoryId}"
      },
      "provider": "agentShiftStatus"
    }
  },
  "isEntityPage": true,
  "schemaVersion": "1.0.0"
